VITE_SUPABASE_URL=your_project_url_here
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side AI settings. Do not prefix Gemini keys with VITE_.
# Gemma Local is the default chat provider. Gemini remains selectable in the UI.
AI_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=google/gemma-4-26b-a4b-qat
LM_STUDIO_REQUEST_TIMEOUT_MS=120000

# Keep false for Mac-only use. On trusted Wi-Fi, true lets a phone open the
# authenticated production app; LM Studio itself remains loopback-only.
APP_LAN_ACCESS=false

# Required for production phone access when APP_LAN_ACCESS=true. Use a random
# value with at least 16 characters and open the printed phone URL with it once.
APP_ACCESS_TOKEN=
APP_PORT=4173

# Optional debugging only. This exposes the unauthenticated Vite dev server.
APP_DEV_LAN_ACCESS=false

# Optional only when LM Studio authentication is enabled.
LM_STUDIO_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview
